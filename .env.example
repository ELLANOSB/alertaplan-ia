# AlertaPlan IA · configuración local (copiar como .env)
APP_TZ=America/Lima

# MySQL de FlyEnv (puerto 3306). instalar.sh crea esta base y este usuario.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=alertaplan_ia
DB_USERNAME=alertaplan
DB_PASSWORD=Claveles.2026
# DB_SOCKET=/Users/<usuario>/Library/FlyEnv/server/mysql/mysql.sock

# IA: auto = Claude si hay API key, si no clasificador local · local · manual
IA_MODO=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
IA_TIMEOUT=20

# Bot de Telegram (token de @BotFather; no subir a repositorios)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USUARIO=

# Seguridad
# Contraseña de las cuentas demo (mín. 10 caracteres con letras y números). Vacía = se genera una aleatoria al instalar.
DEMO_CLAVE=
# 1 solo detrás de un proxy HTTPS de confianza (Railway): cookie Secure e IP real del cliente
CONFIAR_PROXY=
